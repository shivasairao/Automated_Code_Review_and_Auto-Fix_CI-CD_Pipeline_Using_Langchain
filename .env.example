# Copy to .env and fill in. Never commit .env.

# --- LLM provider: google | openai | anthropic ---
LLM_PROVIDER=google

# Google Gemini (default). Get a key from Google AI Studio.
GOOGLE_API_KEY=
GOOGLE_MODEL=gemini-3.6-flash

# Optional alternatives
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

LLM_TIMEOUT_SECONDS=120
LLM_MAX_RETRIES=3

# --- Pipeline behaviour ---
# Severity levels: info | low | medium | high | critical
FAIL_ON=high
MIN_FIX_SEVERITY=medium
MAX_FILE_CHARS=60000
MAX_FIX_ATTEMPTS=3
MAX_WORKERS=4
LOG_LEVEL=INFO
